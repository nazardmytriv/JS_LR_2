<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Завдання 2</title>
</head>
<body>
  <script>
    // Мій номер в журналі - 5. Залишок від ділення 5 на 10 = 5.
    const secretNumber = 5 % 10; 

    let guess = prompt("Вгадайте число від 0 до 9:");

    // Переводимо рядок у число для суворого порівняння
    if (Number(guess) === secretNumber) {
      alert("Correct!");
    } else {
      alert("Wrong!");
    }
  </script>
</body>
</html>